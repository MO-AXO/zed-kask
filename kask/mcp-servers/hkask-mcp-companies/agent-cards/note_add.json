{
  "name": "note_add",
  "server": "hkask-mcp-companies",
  "group": "portfolio_ledger",
  "description": "Add a dated note to a company or security.",
  "parameters": {
    "type": "object",
    "required": ["portfolio", "symbol", "date", "title", "body"],
    "properties": {
      "portfolio": { "type": "string" },
      "symbol": { "type": "string", "description": "Ticker symbol." },
      "date": { "type": "string", "description": "YYYY-MM-DD." },
      "title": { "type": "string" },
      "body": { "type": "string" },
      "tags": { "type": "array", "items": { "type": "string" }, "description": "Optional tags." }
    }
  }
}
