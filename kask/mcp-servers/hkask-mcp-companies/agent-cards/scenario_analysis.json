{
  "name": "scenario_analysis",
  "server": "hkask-mcp-companies",
  "group": "portfolio_analytics_and_dcf",
  "description": "Run four growth-by-margin scenarios (Bull, Land Grab, Cash Cow, Bear) and return the intrinsic-value range via DCF under each scenario.",
  "parameters": {
    "type": "object",
    "required": ["symbol"],
    "properties": {
      "symbol": { "type": "string", "description": "Ticker symbol" },
      "discount_rate": { "type": "number", "description": "WACC. Default 0.10." },
      "terminal_growth": { "type": "number", "description": "Terminal growth rate. Default 0.025." }
    }
  }
}
